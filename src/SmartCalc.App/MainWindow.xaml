<Window x:Class="SmartCalc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartCalc.App.ViewModels"
        xmlns:views="clr-namespace:SmartCalc.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="SmartCalc"
        MinWidth="360" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsTopmost}"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= SIDEBAR CHẾ ĐỘ ======================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="210"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <Setter Property="Width" Value="56"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,8,6,6">
                    <Button Style="{StaticResource IconButton}" Content="&#xE700;"
                            Command="{Binding ToggleSidebarCommand}" ToolTip="Thu gọn / mở rộng"/>
                    <TextBlock Text="SmartCalc" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="18,8,8,14" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="Alt+1…7 để đổi chế độ"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>

                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ModeItem">
                            <Grid ToolTip="{Binding ToolTip}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource ModeIcon}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" CornerRadius="9" Padding="7,2" Margin="4,0,8,0"
                                        Background="{DynamicResource HoverOverlay}" VerticalAlignment="Center"
                                        Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Sắp ra mắt" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======================= VÙNG CHÍNH ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh trên: tên chế độ + các nút theme/ghim/lịch sử -->
            <DockPanel Grid.Row="0" Margin="16,8,8,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE81C;" ToolTip="Lịch sử / Bộ nhớ"
                            Command="{Binding ToggleSidePanelCommand}" Tag="{Binding IsSidePanelOpen}"
                            Visibility="{Binding ShowSidePanelToggle, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource IconButton}" Content="{Binding ThemeIcon}" ToolTip="{Binding ThemeToolTip}"
                            Command="{Binding ToggleThemeCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="{Binding PinIcon}" ToolTip="{Binding PinToolTip}"
                            Command="{Binding ToggleTopmostCommand}" Tag="{Binding IsTopmost}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedMode.Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ============ MÁY TÍNH (Cơ bản / Khoa học) ============ -->
                <Grid Grid.Column="0" Grid.ColumnSpan="{Binding MainColumnSpan}" Margin="12,8,12,12"
                      Visibility="{Binding IsCalculatorMode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="110"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>

                    <!-- Màn hình 2 dòng -->
                    <Border Grid.Row="0" CornerRadius="12" Background="{DynamicResource DisplayBg}" Padding="18,10" Margin="3,0,3,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- DEG/RAD (chỉ chế độ Khoa học) -->
                            <Button Grid.Row="0" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                    Content="{Binding AngleLabel}" Command="{Binding ToggleAngleCommand}"
                                    ToolTip="Đổi đơn vị góc (độ / radian)"
                                    Visibility="{Binding IsScientificMode, Converter={StaticResource BoolToVis}}"/>

                            <!-- Màn hình 2 dòng dùng chung (Views/ExpressionDisplay.xaml) -->
                            <views:ExpressionDisplay Grid.Row="1" Grid.RowSpan="2"/>
                        </Grid>
                    </Border>

                    <!-- Hàng phím bộ nhớ -->
                    <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,4">
                        <Button Style="{StaticResource MemKey}" Content="MC" Command="{Binding MemoryClearCommand}" ToolTip="Xoá bộ nhớ"/>
                        <Button Style="{StaticResource MemKey}" Content="MR" Command="{Binding MemoryRecallCommand}" ToolTip="Gọi lại bộ nhớ"/>
                        <Button Style="{StaticResource MemKey}" Content="M+" Command="{Binding MemoryAddCommand}" ToolTip="Cộng vào bộ nhớ"/>
                        <Button Style="{StaticResource MemKey}" Content="M−" Command="{Binding MemorySubtractCommand}" ToolTip="Trừ khỏi bộ nhớ"/>
                        <Button Style="{StaticResource MemKey}" Content="MS" Command="{Binding MemorySaveCommand}" ToolTip="Lưu vào bộ nhớ"/>
                    </UniformGrid>

                    <!-- Bàn phím theo chế độ -->
                    <views:BasicKeypad Grid.Row="2"
                                       Visibility="{Binding IsBasicMode, Converter={StaticResource BoolToVis}}"/>
                    <views:ScientificKeypad Grid.Row="2"
                                            Visibility="{Binding IsScientificMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- ============ LẬP TRÌNH / ĐỔI ĐƠN VỊ / NGÀY THÁNG ============ -->
                <views:ProgrammerView Grid.Column="0" Grid.ColumnSpan="2" Margin="12,8,12,12" DataContext="{Binding Programmer}"
                                      Visibility="{Binding DataContext.IsProgrammerMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:ConverterView Grid.Column="0" Grid.ColumnSpan="2" Margin="12,8,12,12" DataContext="{Binding Converter}"
                                     Visibility="{Binding DataContext.IsConverterMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                <!-- ============ VẼ ĐỒ THỊ / THỐNG KÊ ============ -->
                <views:GraphView Grid.Column="0" Grid.ColumnSpan="2" Margin="12,8,12,12" DataContext="{Binding Graph}"
                                 Visibility="{Binding DataContext.IsGraphMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:StatisticsView Grid.Column="0" Grid.ColumnSpan="2" Margin="12,8,12,12" DataContext="{Binding Statistics}"
                                      Visibility="{Binding DataContext.IsStatisticsMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                <!-- ============ SẮP RA MẮT ============ -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="{Binding MainColumnSpan}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding IsComingSoon, Converter={StaticResource BoolToVis}}">
                    <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource AccentSoftBg}" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Icon}" DataContext="{Binding SelectedMode}"
                                   Style="{StaticResource ModeIcon}" FontSize="36"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Sắp ra mắt" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"
                               Foreground="{DynamicResource SubtleTextBrush}" FontSize="14">
                        <Run Text="Chế độ"/> <Run Text="{Binding SelectedMode.Name, Mode=OneWay}" FontWeight="SemiBold"/> <Run
                             Text="sẽ có trong phiên bản tới."/>
                    </TextBlock>
                </StackPanel>

                <!-- ============ PANEL PHẢI: Lịch sử / Bộ nhớ ============ -->
                <Border Grid.Column="1" Width="300" Margin="0,8,12,12" CornerRadius="12" Background="{DynamicResource PanelBg}"
                        Visibility="{Binding ShowSidePanel, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <!-- Cửa sổ hẹp: panel đè lên bàn phím, thêm bóng đổ -->
                                <DataTrigger Binding="{Binding IsSidePanelOverlay}" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:SidePanel/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

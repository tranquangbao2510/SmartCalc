<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu TỐI (cùng khoá với Light.xaml). -->
    <SolidColorBrush x:Key="WindowBg" Color="#1B1C20"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#222328"/>
    <SolidColorBrush x:Key="PanelBg" Color="#202126"/>
    <SolidColorBrush x:Key="DisplayBg" Color="#26272D"/>
    <SolidColorBrush x:Key="KeyDigitBg" Color="#33353C"/>
    <SolidColorBrush x:Key="KeyOpBg" Color="#2A2C32"/>
    <SolidColorBrush x:Key="KeyBorder" Color="#383A42"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="SelectedBg" Color="#33363F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentSoftBg" Color="#26344F"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F2F5"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA0AC"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="ErrorSoftBg" Color="#4A2427"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#33353C"/>
</ResourceDictionary>

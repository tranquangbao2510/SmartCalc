<UserControl x:Class="SmartCalc.App.Views.BasicKeypad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bàn phím Cơ bản 4 x 6. Cột/hàng chia "*" nên phím co giãn theo cửa sổ. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Hàng 0 -->
        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource OpKey}" Content="(" Command="{Binding InputCommand}" CommandParameter="("/>
        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource OpKey}" Content=")" Command="{Binding InputCommand}" CommandParameter=")"/>
        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource OpKey}" Content="%" Command="{Binding InputCommand}" CommandParameter="%" ToolTip="Chia lấy dư"/>
        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource OpKey}" Content="C" Command="{Binding ClearCommand}" ToolTip="Xoá (Esc)"/>

        <!-- Hàng 1 -->
        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FuncKey}" Content="Ans" Command="{Binding InputCommand}" CommandParameter="Ans" ToolTip="Kết quả trước"/>
        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource OpKey}" Content="±" Command="{Binding NegateCommand}" ToolTip="Đổi dấu"/>
        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource OpKey}" Command="{Binding BackspaceCommand}" ToolTip="Xoá lùi (Backspace)">
            <TextBlock Text="&#xE750;" FontFamily="{StaticResource IconFont}"/>
        </Button>
        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource OpKey}" Content="÷" Command="{Binding InputCommand}" CommandParameter="÷"/>

        <!-- Hàng 2..4: chữ số + toán tử -->
        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DigitKey}" Content="7" Command="{Binding InputCommand}" CommandParameter="7"/>
        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DigitKey}" Content="8" Command="{Binding InputCommand}" CommandParameter="8"/>
        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DigitKey}" Content="9" Command="{Binding InputCommand}" CommandParameter="9"/>
        <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource OpKey}" Content="×" Command="{Binding InputCommand}" CommandParameter="×"/>

        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource DigitKey}" Content="4" Command="{Binding InputCommand}" CommandParameter="4"/>
        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource DigitKey}" Content="5" Command="{Binding InputCommand}" CommandParameter="5"/>
        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource DigitKey}" Content="6" Command="{Binding InputCommand}" CommandParameter="6"/>
        <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource OpKey}" Content="−" Command="{Binding InputCommand}" CommandParameter="−"/>

        <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource DigitKey}" Content="1" Command="{Binding InputCommand}" CommandParameter="1"/>
        <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource DigitKey}" Content="2" Command="{Binding InputCommand}" CommandParameter="2"/>
        <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource DigitKey}" Content="3" Command="{Binding InputCommand}" CommandParameter="3"/>
        <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource OpKey}" Content="+" Command="{Binding InputCommand}" CommandParameter="+"/>

        <!-- Hàng 5 -->
        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DigitKey}" Content="0" Command="{Binding InputCommand}" CommandParameter="0"/>
        <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource DigitKey}" Content="." Command="{Binding InputCommand}" CommandParameter="." ToolTip="Dấu thập phân (. hoặc ,)"/>
        <Button Grid.Row="5" Grid.Column="3" Style="{StaticResource AccentKey}" Content="=" Command="{Binding EvaluateCommand}" ToolTip="Tính (Enter)"/>
    </Grid>
</UserControl>

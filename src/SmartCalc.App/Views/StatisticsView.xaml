<UserControl x:Class="SmartCalc.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCalc.App.ViewModels">
    <!-- Chế độ Thống kê (DataContext = StatisticsViewModel) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0" MaxWidth="760">
            <!-- Nhập dữ liệu -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="12"
                                Content="&#xE711;" Command="{Binding ClearInputCommand}" ToolTip="Xoá dữ liệu"/>
                        <TextBlock Text="DÃY SỐ" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <TextBox Style="{StaticResource InputBox}" FontSize="16" MinHeight="90" MaxHeight="220"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HasError}"/>
                    <TextBlock Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}"
                               Text="Phân tách bằng dấu cách, dấu phẩy, chấm phẩy hoặc xuống dòng. Dấu thập phân là dấu chấm (vd 2.5)."/>
                    <TextBlock Margin="2,4,0,0" Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Kết quả -->
            <Border Style="{StaticResource Card}" Margin="3,6,3,3">
                <StackPanel>
                    <TextBlock Text="KẾT QUẢ" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Nhập ít nhất một số để xem kết quả." Foreground="{DynamicResource SubtleTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:StatRow">
                                <StackPanel>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6,0,4"
                                            Visibility="{Binding IsGroupStart, Converter={StaticResource BoolToVis}}"/>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Symbol}" FontStyle="Italic" FontSize="15"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="17" FontWeight="SemiBold"
                                                   TextAlignment="Right" TextWrapping="Wrap" MaxWidth="380"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Dữ liệu đã sắp xếp -->
            <Border Margin="3,6,3,3">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SortedText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="DỮ LIỆU ĐÃ SẮP XẾP" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding SortedText}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

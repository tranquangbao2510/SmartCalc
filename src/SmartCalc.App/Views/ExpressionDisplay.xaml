<UserControl x:Class="SmartCalc.App.Views.ExpressionDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartCalc.App.Controls">
    <!-- Màn hình 2 dòng dùng chung (DataContext = KeypadViewModel):
         dòng trên = biểu thức (nhỏ, xám, tô đỏ ký tự ở vị trí lỗi), dòng dưới = kết quả / xem trước / lỗi. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <controls:ExpressionTextBlock ExpressionSource="{Binding ExpressionSource}"
                ErrorPosition="{Binding ExpressionErrorPosition}" ShowEquals="{Binding ShowExpressionEquals}"
                MathNotation="{Binding MathNotation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{DynamicResource SubtleTextBrush}"/>
        </Viewbox>

        <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Right" Height="{Binding ResultHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock Text="{Binding BottomText}" FontFamily="{StaticResource DisplayFont}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="48"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="FontSize" Value="22"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Viewbox>
    </Grid>
</UserControl>

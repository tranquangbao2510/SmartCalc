<UserControl x:Class="SmartCalc.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCalc.App.ViewModels"
             xmlns:controls="clr-namespace:SmartCalc.App.Controls">
    <!-- Chế độ Vẽ đồ thị (DataContext = GraphViewModel) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ô nhập tối đa 3 hàm -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="3,0,3,6">
            <ItemsControl ItemsSource="{Binding Functions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:FunctionEntryViewModel">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Chấm màu: bấm để ẩn/hiện đồ thị -->
                            <Button Grid.Column="0" Focusable="False" Cursor="Hand" Width="30" Height="30" Margin="0,0,6,0"
                                    Command="{Binding ToggleVisibleCommand}" ToolTip="Ẩn / hiện đồ thị này">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{Binding Brush}" Stroke="{Binding Brush}" StrokeThickness="2"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                <Setter TargetName="Dot" Property="Fill" Value="Transparent"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"
                                       FontStyle="Italic" Foreground="{DynamicResource SubtleTextBrush}">
                                <Run Text="y"/><Run Text="{Binding Index, Mode=OneWay}" BaselineAlignment="Subscript" FontSize="11"/><Run Text=" ="/>
                            </TextBlock>

                            <TextBox Grid.Column="2" Style="{StaticResource InputBox}" FontSize="16" Padding="10,5"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HasError}"
                                     ToolTip="Biểu thức theo x, vd: sin(x), x^2 - 3x + 1, 1/x, sqrt(x)"/>

                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="12"
                                    Content="&#xE711;" Command="{Binding ClearTextCommand}" ToolTip="Xoá hàm này"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="12" Margin="4,3,0,2" TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Vùng vẽ -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource DisplayBg}" Margin="3" Padding="2">
            <Grid>
                <controls:GraphCanvas x:Name="Canvas"
                                      Plots="{Binding Plots}"
                                      Viewport="{Binding Viewport}"
                                      CursorPoint="{Binding CursorPoint}"
                                      GridBrush="{DynamicResource DividerBrush}"
                                      AxisBrush="{DynamicResource SubtleTextBrush}"
                                      LabelBrush="{DynamicResource SubtleTextBrush}"/>

                <!-- Nút zoom (góc trên phải) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="10"
                        Background="{DynamicResource PanelBg}" Opacity="0.95">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Command="{Binding ZoomInCommand}" ToolTip="Phóng to"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Command="{Binding ZoomOutCommand}" ToolTip="Thu nhỏ"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding ResetViewCommand}" ToolTip="Đặt lại vùng nhìn"/>
                    </StackPanel>
                </Border>

                <!-- Toạ độ con trỏ / hướng dẫn (góc dưới trái) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" CornerRadius="8" Padding="10,4"
                        Background="{DynamicResource PanelBg}" Opacity="0.95" IsHitTestVisible="False">
                    <TextBlock Text="{Binding CursorText}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="SmartCalc.App.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCalc.App.ViewModels"
             xmlns:units="clr-namespace:SmartCalc.Core.Units;assembly=SmartCalc.Core">
    <!-- Chế độ Đổi đơn vị (DataContext = UnitConverterViewModel) -->
    <UserControl.Resources>
        <DataTemplate x:Key="UnitChip" DataType="units:Unit">
            <TextBlock Text="{Binding Symbol}" ToolTip="{Binding Name}"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <!-- Nhóm đơn vị -->
            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     Margin="3,0,0,6">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CategoryItem">
                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TỪ -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TỪ" Style="{StaticResource SectionLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" FontSize="30" FontWeight="SemiBold"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HasError}"
                                 ToolTip="Nhập số (dùng . hoặc , làm dấu thập phân)"/>
                        <TextBlock Text="{Binding FromUnit.Name}" Foreground="{DynamicResource SubtleTextBrush}" Margin="2,6,0,10"/>
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Units}" SelectedItem="{Binding FromUnit}"
                                 ItemTemplate="{StaticResource UnitChip}"/>
                    </StackPanel>
                </Border>

                <!-- Nút đảo chiều -->
                <Button Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="2,52,2,0"
                        Content="&#xE8AB;" Command="{Binding SwapCommand}" ToolTip="Đảo chiều chuyển đổi"/>

                <!-- SANG -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SANG" Style="{StaticResource SectionLabel}"/>
                        <Grid MinHeight="50">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="46"
                                     Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{Binding ResultText}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"/>
                            </Viewbox>
                            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding ToUnit.Name}" Foreground="{DynamicResource SubtleTextBrush}" Margin="2,6,0,10"/>
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Units}" SelectedItem="{Binding ToUnit}"
                                 ItemTemplate="{StaticResource UnitChip}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bảng quy đổi ra mọi đơn vị của nhóm -->
            <Border Style="{StaticResource Card}" Margin="3,6,3,3">
                <StackPanel>
                    <TextBlock Text="BẢNG QUY ĐỔI" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding AllConversions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ConversionRow">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontSize="15" Margin="10,0,0,0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
